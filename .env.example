APP_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
# true apenas para ensaiar o build local com npm start (após npm run build).
SERVE_WEB=false
# Dados reais: APP_MODE=mongo após preparar índices e importar o histórico.
# Segredos exclusivamente no backend; nunca usar prefixo VITE_.
MONGODB_URI=
MONGODB_DB=jbr_crm_dev
MONGODB_MAX_POOL_SIZE=8
# Chave AES-256 em base64, criada por mongo:credentials; guardar separada dos dumps.
CREDENTIALS_ENCRYPTION_KEY=
# true permite processar a fila; scheduler=true também agenda coletas periódicas.
INTEGRATIONS_ENABLED=false
SYNC_SCHEDULER_ENABLED=false
# Render: worker no mesmo Web Service; local usa dev:worker separado.
EMBEDDED_WORKER=false
# Obrigatórios em NODE_ENV=production e APP_MODE=mongo. Gerar com render:prepare.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
GOOGLE_ADS_API_VERSION=v26
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://127.0.0.1:3001/oauth/google/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_REFRESH_TOKEN=
UMBLER_TALK_TOKEN=
