{
  "name": "jbr-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "tsx watch back-end/src/index.ts",
    "dev:web": "vite --config front-end/vite.config.ts --host 127.0.0.1",
    "build": "npm run typecheck && npm run build:web && npm run build:api",
    "start": "node back-end/dist/server.js",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run",
    "db:migrate": "tsx back-end/scripts/mongo.ts setup",
    "start:worker": "node back-end/dist/worker.js worker",
    "sync:umbler": "tsx back-end/scripts/mongo.ts umbler",
    "sync:attendance": "tsx back-end/scripts/mongo.ts umbler",
    "test:collector": "python -m unittest discover -s back-end/scripts/umbler -p test_*.py",
    "google:authorize": "tsx back-end/scripts/google-authorize.ts",
    "sync:google": "tsx back-end/scripts/mongo.ts google",
    "mongo:check": "tsx back-end/scripts/mongo.ts check",
    "mongo:setup": "tsx back-end/scripts/mongo.ts setup",
    "mongo:import": "tsx back-end/scripts/mongo-import.ts",
    "mongo:credentials": "tsx back-end/scripts/mongo.ts credentials",
    "dev:worker": "tsx back-end/scripts/mongo.ts worker",
    "sync:budget": "tsx back-end/scripts/mongo.ts budget",
    "mongo:verify": "tsx back-end/scripts/mongo-verify.ts",
    "mongo:backup": "tsx back-end/scripts/mongo-backup.ts",
    "privacy:verify": "tsx back-end/scripts/message-storage-verify.ts",
    "privacy:purge": "tsx back-end/scripts/mongo.ts purge-content",
    "privacy:purge-local": "tsx back-end/scripts/purge-local-message-content.ts",
    "mongo:compact": "tsx back-end/scripts/mongo.ts compact",
    "mongo:storage-verify": "tsx back-end/scripts/mongo-storage-verify.ts",
    "attendance:verify": "tsx back-end/scripts/attendance-period-verify.ts",
    "mongo:repack": "tsx back-end/scripts/mongo-repack.ts",
    "build:web": "vite build --config front-end/vite.config.ts",
    "verify:layout": "tsx back-end/scripts/verify-layout.ts",
    "build:api": "esbuild back-end/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=back-end/dist/server.js && esbuild back-end/scripts/mongo.ts --bundle --platform=node --format=esm --packages=external --outfile=back-end/dist/worker.js",
    "typecheck": "tsc -p front-end/tsconfig.json && tsc -p back-end/tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@tanstack/react-query": "^5.90.0",
    "dotenv": "16.6.1",
    "fastify": "^5.6.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.468.0",
    "mongodb": "7.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
