{
  "name": "jbr-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "sync:umbler": "powershell -NoProfile -File scripts/sync-umbler.ps1",
    "sync:attendance": "powershell -NoProfile -File scripts/enrich-umbler.ps1",
    "test:collector": "python -m unittest discover -s scripts/umbler -p test_*.py",
    "google:authorize": "tsx scripts/google-authorize.ts",
    "sync:google": "powershell -NoProfile -File scripts/sync-google.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@tanstack/react-query": "^5.90.0",
    "fastify": "^5.6.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  }
}
