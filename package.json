{
  "name": "jbr-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild scripts/mongo.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "db:migrate": "tsx scripts/mongo.ts setup",
    "start:worker": "node dist/worker.js worker",
    "sync:umbler": "tsx scripts/mongo.ts umbler",
    "sync:attendance": "tsx scripts/mongo.ts umbler",
    "test:collector": "python -m unittest discover -s scripts/umbler -p test_*.py",
    "google:authorize": "tsx scripts/google-authorize.ts",
    "sync:google": "tsx scripts/mongo.ts google",
    "mongo:check": "tsx scripts/mongo.ts check",
    "mongo:setup": "tsx scripts/mongo.ts setup",
    "mongo:import": "tsx scripts/mongo-import.ts",
    "mongo:credentials": "tsx scripts/mongo.ts credentials",
    "dev:worker": "tsx scripts/mongo.ts worker",
    "sync:budget": "tsx scripts/mongo.ts budget",
    "mongo:verify": "tsx scripts/mongo-verify.ts",
    "mongo:backup": "tsx scripts/mongo-backup.ts",
    "privacy:verify": "tsx scripts/message-storage-verify.ts",
    "privacy:purge": "tsx scripts/mongo.ts purge-content",
    "privacy:purge-local": "tsx scripts/purge-local-message-content.ts",
    "mongo:compact": "tsx scripts/mongo.ts compact",
    "mongo:storage-verify": "tsx scripts/mongo-storage-verify.ts",
    "attendance:verify": "tsx scripts/attendance-period-verify.ts",
    "mongo:repack": "tsx scripts/mongo-repack.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.12",
    "@tanstack/react-query": "^5.90.0",
    "dotenv": "16.6.1",
    "fastify": "^5.6.0",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.468.0",
    "mongodb": "7.9.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
